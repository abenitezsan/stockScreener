# Imagen a desplegar (solo la usa docker compose)
STOCKSCREENER_IMAGE=tuusuario/stockscreener:latest
# Puerto del host (solo 127.0.0.1) si el 8000 ya lo usa otra aplicación
# STOCKSCREENER_PORT=8010

# Base de datos SQLite. En Docker ya viene configurada en el volumen /data; fuera de Docker,
# por defecto es data/stockscreener.db en el directorio de trabajo.
# DATABASE_URL=sqlite:////data/stockscreener.db

# Divisa base de la cartera
BASE_CURRENCY=EUR
# Clave para firmar la cookie de sesión (genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=cambia-esto
TIMEZONE=Europe/Madrid

# Valoración (ver docs/valoracion.md)
VALUATION_WINDOW_YEARS=5
MARGIN_OF_SAFETY=0.10
TARGET_TOTAL_RETURN=0.05
GORDON_DISCOUNT_RATE=0.08
GROWTH_CAP=0.05

# Descarga de datos y tareas programadas
REQUEST_DELAY=1.0
BATCH_SIZE=50
SCHEDULER_ENABLED=true
