# Imagen a desplegar (solo la usa docker compose)
STOCKSCREENER_IMAGE=abenitezsan/stockscreener:latest
# Subruta pública detrás de nginx (docker-compose.yml ya usa /stockscreener por defecto)
# ROOT_PATH=/stockscreener

# Base de datos SQLite. En Docker ya viene configurada en /data (carpeta ./data del host);
# fuera de Docker, por defecto es data/stockscreener.db en el directorio de trabajo.
# DATABASE_URL=sqlite:////data/stockscreener.db

# Divisa base de la cartera
BASE_CURRENCY=EUR
# Reservada: las sesiones no la usan (llevan un token aleatorio guardado en la base de datos)
SECRET_KEY=cambia-esto
# Email del superadministrador: ve «Usuarios» en el menú (crear, cambiar contraseña, cerrar
# sesiones y borrar). Esa cuenta NO se puede registrar desde la web; se crea una vez con:
#   docker compose exec stockscreener python -m app.cli set-password tu@email.com
SUPERADMIN_EMAIL=
TIMEZONE=Europe/Madrid

# Logs a fichero (docker-compose.yml ya usa /app/logs, montado en ./logs)
# LOG_DIR=/app/logs
# LOG_LEVEL=INFO
# LOG_MAX_MB=10
# LOG_BACKUPS=14

# Valoración (ver docs/valoracion.md)
VALUATION_WINDOW_YEARS=5
MARGIN_OF_SAFETY=0.10
TARGET_TOTAL_RETURN=0.05
GORDON_DISCOUNT_RATE=0.08
GROWTH_CAP=0.05

# Descarga de datos y tareas programadas
REQUEST_DELAY=1.0
BATCH_SIZE=50
SCHEDULER_ENABLED=true
