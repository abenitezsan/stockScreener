# Conexión a la base de datos Postgres existente en el VPS
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/midb
# Esquema propio de la aplicación dentro de esa base de datos
DB_SCHEMA=stockscreener
# Divisa base de la cartera
BASE_CURRENCY=EUR
# Clave para firmar la cookie de sesión (genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=cambia-esto
